# Django Core Settings
DJANGO_SECRET_KEY=your-secret-key-here-generate-with-get_random_secret_key
DJANGO_SETTINGS_MODULE=talkeasy.settings.development
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
DB_ENGINE=django.db.backends.mysql
DB_NAME=talkeasytest
DB_USER=admin
DB_PASSWORD=your-database-password
DB_HOST=your-database-host.rds.amazonaws.com
DB_PORT=3306

# Razorpay Configuration
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=whsec_XXXXXXXXXXXX

# Agora Configuration
AGORA_APP_ID=your-agora-app-id
AGORA_APP_CERTIFICATE=your-agora-certificate
AGORA_TOKEN_TTL_SECONDS=3600

# External Services
TWO_FACTOR_API_KEY=your-2fa-api-key

# RabbitMQ Configuration
RABBITMQ_URL=amqp://myuser:mypassword@localhost:5672/

# CORS Configuration (comma-separated domains)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# JWT Token Configuration (in days)
JWT_ACCESS_TOKEN_LIFETIME_DAYS=1
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Coins Configuration
COINS_PER_SECOND=3
