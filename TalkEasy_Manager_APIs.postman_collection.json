{
    "info": {
        "name": "TalkEasy – Manager APIs",
        "_postman_id": "talkeasy-manager-apis-collection",
        "description": "Complete Postman collection for all Manager-related Admin APIs in the TalkEasy project.\n\n**Auth**: All endpoints require a Bearer JWT token from the Superadmin login.\n\n**Base URL variable**: `{{base_url}}` (default: http://127.0.0.1:8000)",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "base_url",
            "value": "http://127.0.0.1:8000",
            "type": "string"
        },
        {
            "key": "admin_token",
            "value": "YOUR_SUPERADMIN_JWT_TOKEN",
            "type": "string"
        },
        {
            "key": "manager_id",
            "value": "",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "Auth",
            "item": [
                {
                    "name": "Superadmin Login",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 200) {",
                                    "    const json = pm.response.json();",
                                    "    pm.collectionVariables.set('admin_token', json.access_token);",
                                    "    console.log('Token saved:', json.access_token);",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"admin@test.com\",\n  \"password\": \"adminpassword\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/accounts/admin/login/",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "accounts",
                                "admin",
                                "login",
                                ""
                            ]
                        },
                        "description": "Login as superadmin. The test script auto-saves the `access_token` to `admin_token` collection variable."
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "Manager User",
            "item": [
                {
                    "name": "Create Manager User",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 201) {",
                                    "    const json = pm.response.json();",
                                    "    pm.collectionVariables.set('manager_id', json.data.id);",
                                    "    console.log('Manager User ID saved:', json.data.id);",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{admin_token}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name\": \"Manager User 1\",\n  \"email\": \"manageruser1@test.com\",\n  \"password\": \"managerpass\",\n  \"mobile_number\": \"1231231234\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/accounts/create-manager-user/",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "accounts",
                                "create-manager-user",
                                ""
                            ]
                        },
                        "description": "Create a new Manager User (role: manager_user). Requires superadmin JWT.\n\n**Response 201**: Returns `{ message, data: { id, name, email, mobile_number, role } }`"
                    },
                    "response": [
                        {
                            "name": "201 Created",
                            "originalRequest": {
                                "method": "POST",
                                "body": {
                                    "mode": "raw",
                                    "raw": "{\n  \"name\": \"Manager User 1\",\n  \"email\": \"manageruser1@test.com\",\n  \"password\": \"managerpass\",\n  \"mobile_number\": \"1231231234\"\n}"
                                }
                            },
                            "status": "Created",
                            "code": 201,
                            "_postman_previewlanguage": "json",
                            "body": "{\n  \"message\": \"Manager User created successfully\",\n  \"data\": {\n    \"id\": 5,\n    \"name\": \"Manager User 1\",\n    \"email\": \"manageruser1@test.com\",\n    \"mobile_number\": \"1231231234\",\n    \"role\": \"manager_user\"\n  }\n}"
                        }
                    ]
                },
                {
                    "name": "Login Manager User",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"manageruser1@test.com\",\n  \"password\": \"managerpass\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/accounts/login-manager-user/",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "accounts",
                                "login-manager-user",
                                ""
                            ]
                        },
                        "description": "Login as a Manager User. Returns JWT access and refresh tokens.\n\n**Response 200**: `{ message, data: { id, name, email, role, access_token, refresh_token } }`"
                    },
                    "response": []
                },
                {
                    "name": "Delete Manager User",
                    "request": {
                        "method": "DELETE",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{admin_token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/accounts/manager-users/{{manager_id}}/delete/",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "accounts",
                                "manager-users",
                                "{{manager_id}}",
                                "delete",
                                ""
                            ]
                        },
                        "description": "Delete a Manager User by ID. Requires superadmin JWT.\n\n**Response 204**: No Content"
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "Manager Executive",
            "item": [
                {
                    "name": "Create Manager Executive",
                    "event": [
