                        "description": "Create a new Manager Executive (role: manager_executive). Requires superadmin JWT.\n\n**Response 201**: `{ message, data: { id, name, email, mobile_number, role } }`"
                    },
                    "response": []
                },
                {
                    "name": "Login Manager Executive",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"managerexec1@test.com\",\n  \"password\": \"execpass123\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/accounts/login-manager/",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "accounts",
                                "login-manager",
                                ""
                            ]
                        },
                        "description": "Login as a Manager Executive. Returns JWT access and refresh tokens.\n\n**Response 200**: `{ message, data: { id, name, email, role, access_token, refresh_token } }`"
                    },
                    "response": []
                },
                {
                    "name": "Delete Manager Executive",
                    "request": {
                        "method": "DELETE",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{admin_token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/accounts/manager-executives/{{manager_id}}/delete/",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "accounts",
                                "manager-executives",
                                "{{manager_id}}",
                                "delete",
                                ""
                            ]
                        },
                        "description": "Delete a Manager Executive by ID. Requires superadmin JWT.\n\n**Response 204**: No Content"
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "Manager List & Permissions",
            "item": [
                {
                    "name": "List All Managers",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{admin_token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/accounts/managers/?role=manager_user",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "accounts",
                                "managers",
                                ""
                            ],
                            "query": [
                                {
                                    "key": "role",
                                    "value": "manager_user",
                                    "description": "Optional. Filter by role: `manager_user` or `manager_executive`. Leave empty for all managers."
                                }
                            ]
                        },
                        "description": "List all managers (both manager_user and manager_executive roles). Filter by `?role=manager_user` or `?role=manager_executive`.\n\n**Response 200**: Array of `{ id, name, email, mobile_number, role, is_active, is_banned, created_at }`"
                    },
                    "response": [
                        {
                            "name": "200 OK – All Managers",
                            "status": "OK",
                            "code": 200,
                            "_postman_previewlanguage": "json",
                            "body": "[\n  {\n    \"id\": 3,\n    \"name\": \"Manager User 1\",\n    \"email\": \"manageruser1@test.com\",\n    \"mobile_number\": \"1231231234\",\n    \"role\": \"manager_user\",\n    \"custom_permissions\": [],\n    \"is_banned\": false,\n    \"is_active\": true,\n    \"created_at\": \"2026-02-21T07:00:00Z\"\n  }\n]"
                        }
                    ]
                },
                {
                    "name": "Update Manager Permissions",
                    "request": {
                        "method": "PATCH",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{admin_token}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"custom_permissions\": [\"view_users\", \"edit_executives\"]\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/accounts/admin/{{manager_id}}/permissions/",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "accounts",
                                "admin",
                                "{{manager_id}}",
                                "permissions",
                                ""
                            ]
                        },
                        "description": "Update the `custom_permissions` list for any admin/manager. Requires superadmin JWT.\n\n**Response 200**: `{ message, data: { id, name, email, role, custom_permissions } }`"
                    },
                    "response": []
                },
                {
                    "name": "Update Manager Profile (Self or By ID)",
                    "request": {
                        "method": "PATCH",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{admin_token}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name\": \"Updated Manager Name\",\n  \"mobile_number\": \"9000000001\",\n  \"is_banned\": false\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/accounts/admin/update/{{manager_id}}/",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "accounts",
                                "admin",
                                "update",
                                "{{manager_id}}",
                                ""
                            ]
                        },
                        "description": "Update a manager's profile. Superadmin can update any manager by ID. A non-superadmin can only update their own profile via `/accounts/admin-update/`.\n\n**Response 200**: `{ message, data: { id, name, email, ...} }`"
                    },
                    "response": []
                }
            ]
        }
    ]
}