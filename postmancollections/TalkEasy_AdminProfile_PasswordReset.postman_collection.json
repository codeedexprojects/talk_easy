{
    "info": {
        "name": "TalkEasy – Admin Profile & Phone OTP Reset",
        "_postman_id": "talkeasy-admin-profile-phone-otp",
        "description": "Admin Profile (GET/PATCH, JWT-protected) and 3-step Phone OTP-based Password Reset for TalkEasy backend.\n\nFlow:\n1. Admin Login → get access_token\n2. GET/PATCH Admin Profile\n3. Request OTP (Phone) → check console\n4. Verify OTP (Phone)\n5. Reset Password (Phone)",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "base_url",
            "value": "http://127.0.0.1:8000",
            "type": "string"
        },
        {
            "key": "admin_token",
            "value": "",
            "type": "string"
        },
        {
            "key": "admin_phone",
            "value": "+919876543210",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "1. Auth",
            "item": [
                {
                    "name": "Admin Login",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "var json = pm.response.json();",
                                    "if (json.access_token) {",
                                    "  pm.collectionVariables.set('admin_token', json.access_token);",
                                    "  pm.collectionVariables.set('admin_phone', json.mobile || '+919876543210');",
                                    "  console.log('Token saved:', json.access_token.substring(0,20)+'...');",
                                    "}",
                                    "pm.test('Status 200', () => pm.response.to.have.status(200));"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"admin@test.com\",\n  \"password\": \"adminpassword\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/accounts/admin/login/",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "accounts",
                                "admin",
                                "login",
                                ""
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "2. Admin Profile",
            "item": [
                {
                    "name": "GET Admin Profile",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Status 200', () => pm.response.to.have.status(200));",
                                    "var json = pm.response.json();",
                                    "pm.test('No otp_hash exposed', () => pm.expect(json.data || {}).to.not.have.property('otp_hash'));",
                                    "pm.test('No password exposed', () => pm.expect(json.data || {}).to.not.have.property('password'));"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{admin_token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/accounts/admin-profile/",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "accounts",
                                "admin-profile",
                                ""
                            ]
                        }
                    }
                },
                {
                    "name": "PATCH Admin Profile",
                    "request": {
                        "method": "PATCH",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{admin_token}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name\": \"Super Admin\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/accounts/admin-profile/",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "accounts",
                                "admin-profile",
                                ""
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "3. Password Reset (Phone OTP)",
            "item": [
                {
                    "name": "Step 1 — Send OTP",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Status 200 or 429', () => pm.expect(pm.response.code).to.be.oneOf([200, 429]));",
                                    "var json = pm.response.json();",
                                    "console.log('Response:', json.message);",
                                    "if (pm.response.code === 200) console.log('>>> CHECK SERVER CONSOLE FOR OTP');"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"phone\": \"{{admin_phone}}\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/accounts/admin/password-reset/send-otp/",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "accounts",
                                "admin",
                                "password-reset",
                                "send-otp",
                                ""
                            ]
                        }
                    }
                },
                {
                    "name": "Step 2 — Verify OTP",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Status 200 or 400', () => pm.expect(pm.response.code).to.be.oneOf([200, 400]));",
                                    "var json = pm.response.json();",
                                    "if (pm.response.code === 200) console.log('OTP VERIFIED! Proceed to reset.');",
                                    "else console.log('Error:', json.errors);"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"phone\": \"{{admin_phone}}\",\n  \"otp\": \"123456\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/accounts/admin/password-reset/verify-otp/",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "accounts",
                                "admin",
                                "password-reset",
                                "verify-otp",
                                ""
                            ]
                        }
                    }
                },
                {
                    "name": "Step 3 — Reset Password",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Success 200 or Fail 400', () => pm.expect(pm.response.code).to.be.oneOf([200, 400]));",
                                    "var json = pm.response.json();",
                                    "console.log('Result:', json.message || json.errors);"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"phone\": \"{{admin_phone}}\",\n  \"new_password\": \"Strong@Pass123\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/accounts/admin/password-reset/reset/",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "accounts",
                                "admin",
                                "password-reset",
                                "reset",
                                ""
                            ]
                        }
                    }
                }
            ]
        }
    ]
}