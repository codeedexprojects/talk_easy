{
    "info": {
        "name": "TalkEasy – Manager APIs",
        "_postman_id": "talkeasy-manager-apis-collection",
        "description": "Complete Postman collection for all Manager-related Admin APIs in the TalkEasy project.\n\n**Auth**: All endpoints require a Bearer JWT token from the Superadmin login.\n\n**Base URL variable**: `{{base_url}}` (default: http://127.0.0.1:8000)",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "base_url",
            "value": "http://127.0.0.1:8000",
            "type": "string"
        },
        {
            "key": "admin_token",
            "value": "YOUR_SUPERADMIN_JWT_TOKEN",
            "type": "string"
        },
        {
            "key": "manager_id",
            "value": "",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "Auth",
            "item": [
                {
                    "name": "Superadmin Login",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 200) {",
                                    "    const json = pm.response.json();",
                                    "    pm.collectionVariables.set('admin_token', json.access_token);",
                                    "    console.log('Token saved:', json.access_token);",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"admin@test.com\",\n  \"password\": \"adminpassword\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/accounts/admin/login/",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "accounts",
                                "admin",
                                "login",
                                ""
                            ]
                        },
                        "description": "Login as superadmin. The test script auto-saves the `access_token` to `admin_token` collection variable."
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "Managers",
            "item": [
                {
                    "name": "Create Manager",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 201) {",
                                    "    const json = pm.response.json();",
                                    "    pm.collectionVariables.set('manager_id', json.data.id);",
                                    "    console.log('Manager ID saved:', json.data.id);",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{admin_token}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name\": \"Manager Example\",\n  \"email\": \"manager_example@test.com\",\n  \"password\": \"managerpass123\",\n  \"mobile_number\": \"1231231234\",\n  \"manager_level\": \"executive\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/accounts/managers/create/",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "accounts",
                                "managers",
                                "create",
                                ""
                            ]
                        },
                        "description": "Create a new Manager. Requires superadmin JWT.\n- `manager_level` can be `\"executive\"` or `\"user\"`.\n\n**Response 201**: Returns `{ message, data: { id, name, email, mobile_number, role, manager_level } }`"
                    },
                    "response": []
                },
                {
                    "name": "Login Manager",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"manager_example@test.com\",\n  \"password\": \"managerpass123\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/accounts/managers/login/",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "accounts",
                                "managers",
                                "login",
                                ""
                            ]
                        },
                        "description": "Login as a Manager. Returns JWT access and refresh tokens.\n\n**Response 200**: `{ message, data: { id, name, email, role, manager_level, access_token, refresh_token } }`"
                    },
                    "response": []
                },
                {
                    "name": "List All Managers",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{admin_token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/accounts/managers/?manager_level=executive",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "accounts",
                                "managers",
                                ""
                            ],
                            "query": [
                                {
                                    "key": "manager_level",
                                    "value": "executive",
                                    "description": "Optional. Filter by level: `user` or `executive`. Leave empty for all managers."
                                }
                            ]
                        },
                        "description": "List all managers. Filter by `?manager_level=user` or `?manager_level=executive`.\n\n**Response 200**: Array of `{ id, name, email, mobile_number, role, custom_permissions, is_active, is_banned, created_at }`"
                    },
                    "response": []
                },
                {
                    "name": "Get Manager Detail",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{admin_token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/accounts/managers/{{manager_id}}/",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "accounts",
                                "managers",
                                "{{manager_id}}",
                                ""
                            ]
                        },
                        "description": "Get details of a specific Manager by ID. Requires superadmin JWT.\n\n**Response 200**: `{ message, data: { ... } }`"
                    },
                    "response": []
                },
                {
                    "name": "Update Manager Permissions",
                    "request": {
                        "method": "PATCH",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{admin_token}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"custom_permissions\": {\"manager_level\": \"executive\", \"can_view_reports\": true}\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/accounts/permissions/{{manager_id}}/update/",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "accounts",
                                "permissions",
                                "{{manager_id}}",
                                "update",
                                ""
                            ]
                        },
                        "description": "Update the `custom_permissions` JSON for any admin/manager. Requires superadmin JWT.\n\n**Response 200**: `{ message, data: { id, name, email, role, custom_permissions } }`"
                    },
                    "response": []
                },
                {
                    "name": "Update Manager Profile",
                    "request": {
                        "method": "PATCH",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{admin_token}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name\": \"Updated Manager Name\",\n  \"mobile_number\": \"9000000001\",\n  \"is_banned\": false\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/accounts/admin/update/{{manager_id}}/",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "accounts",
                                "admin",
                                "update",
                                "{{manager_id}}",
                                ""
                            ]
                        },
                        "description": "Update a manager's profile. Superadmin can update any manager by ID.\n\n**Response 200**: `{ message, data: { id, name, email, ...} }`"
                    },
                    "response": []
                },
                {
                    "name": "Delete Manager (Legacy Exec Endpoint)",
                    "request": {
                        "method": "DELETE",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{admin_token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/accounts/manager-executives/{{manager_id}}/delete/",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "accounts",
                                "manager-executives",
                                "{{manager_id}}",
                                "delete",
                                ""
                            ]
                        },
                        "description": "Delete a Manager by ID. Requires superadmin JWT.\n\n**Response 204**: No Content"
                    },
                    "response": []
                }
            ]
        }
    ]
}